# --- MatrixFlow Enterprise: variables de entorno ---
# Copia a `backend/.env` (desarrollo) o configúralas en Render/Vercel (producción).

# Base de datos
# Local (fallback SQLite): déjalo vacío o usa sqlite:///./matrixflow_local.db
# Supabase (Session pooler, IPv4, funciona desde Render):
#   postgresql://postgres:[PASSWORD]@aws-0-XX-XXXX.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./matrixflow_local.db

# Seguridad
SECRET_KEY=change_me_in_prod_2026
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: lista exacta de orígenes permitidos, separados por coma.
# Producción: https://TU_APP.vercel.app,https://TU_API.onrender.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Seed del primer arranque (backend/app/bootstrap.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Biométrica (opcional; se usan estos valores por defecto)
# Distancia euclidiana máxima admitida al verificar un rostro
BIOMETRIC_THRESHOLD=0.6
# Umbral más exigente para iniciar sesión con el rostro
BIOMETRIC_LOGIN_THRESHOLD=0.55

# --- Frontend (Vite: se inyecta en build; va en las env vars de Vercel) ---
# Desarrollo: http://localhost:8000
# Producción:  https://TU_API.onrender.com  (sin barra final)
VITE_API_URL=http://localhost:8000
